rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed() { return request.auth != null; }
  function me() { return get(/databases/$(database)/documents/members/$(request.auth.uid)).data; }
  function active() { return signed() && me().status == 'active'; }
  function role(r) { return active() && r in me().roles; }
  function admin() { return role('admin'); }
  function permission(p) { return admin() || (active() && p in me().get('permissions', [])); }
  function memberRole(id,r) { let m=get(/databases/$(database)/documents/members/$(id)).data; return m.status=='active' && r in m.roles; }
  function https(s) { return s is string && s.size()<3000 && (s=='' || s.matches('https://.*')); }
  match /members/{uid} {
   allow get: if signed() && (uid==request.auth.uid || admin());
   allow list: if admin();
   allow create: if signed() && uid==request.auth.uid
    && request.resource.data.keys().hasOnly(['uid','email','displayName','photoURL','status','roles','teams','notify','requestedTeam','requestedUnit','requestReason','createdAt','updatedAt'])
    && request.resource.data.uid==uid && request.resource.data.email==request.auth.token.email
    && request.resource.data.status=='pending' && request.resource.data.roles==[] && request.resource.data.teams==[];
   allow update: if admin()
    && request.resource.data.uid==resource.data.uid && request.resource.data.email==resource.data.email
    && request.resource.data.status in ['pending','active','suspended']
    && request.resource.data.roles is list && request.resource.data.roles.hasOnly(['admin','lead','staff','reviewer','approver','fleet','payroll'])
    && request.resource.data.get('permissions',[]) is list && request.resource.data.get('permissions',[]).hasOnly(['createPlan','createJob','manageSchedule'])
    && request.resource.data.teams is list
    && (uid!=request.auth.uid || (request.resource.data.status=='active' && 'admin' in request.resource.data.roles));
   allow delete: if false;
   match /receipts/{id} {
    allow read: if active() && uid==request.auth.uid;
    allow create,update: if active() && uid==request.auth.uid && request.resource.data.keys().hasOnly(['readAt']) && request.resource.data.readAt is string;
   }
  }
  match /directory/{uid} {
   allow read: if active();
   allow create,update: if (admin() || (active() && uid==request.auth.uid)) && request.resource.data.keys().hasOnly(['name','email','status','roles','teams'])
    && request.resource.data.status==getAfter(/databases/$(database)/documents/members/$(uid)).data.status
    && request.resource.data.roles==getAfter(/databases/$(database)/documents/members/$(uid)).data.roles
    && request.resource.data.teams==getAfter(/databases/$(database)/documents/members/$(uid)).data.teams
    && request.resource.data.email==getAfter(/databases/$(database)/documents/members/$(uid)).data.email;
  }
  match /teams/{id} {
   allow read: if active();
   allow create,update: if admin() && request.resource.data.keys().hasOnly(['name','capacity','updatedAt']) && request.resource.data.name is string && request.resource.data.name.size()>0 && request.resource.data.name.size()<=100 && request.resource.data.capacity is number && request.resource.data.capacity>=0;
  }
  function taskShape(d) {
   return d.keys().hasAll(['title','kind','stage','teamId','ownerId','reviewerId','approverId','visibleTo','createdBy','due','priority','hours','status','progress','reason','note','drawing','boq','checks','revision','history','createdAt','updatedAt'])
    && d.keys().hasOnly(['title','kind','stage','teamId','ownerId','reviewerId','approverId','visibleTo','createdBy','due','priority','hours','status','progress','reason','note','drawing','boq','checks','revision','history','createdAt','updatedAt'])
    && d.title is string && d.title.size()>0 && d.title.size()<=300
    && d.kind in ['plan','job'] && d.stage in ['ส่งแผน','สำรวจ','ออกแบบ','ประมาณราคา','ส่งมอบ']
    && d.priority in ['normal','important','urgent'] && d.status in ['working','blocked','review','revision','approval','done']
    && d.progress is number && d.progress>=0 && d.progress<=100 && d.hours is number && d.hours>=0 && d.hours<=10000
    && d.due is string && d.due.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
    && d.checks is list && d.checks.size()==3 && d.checks.hasOnly([true,false])
    && https(d.drawing) && https(d.boq) && d.reason is string && d.reason.size()<=1000
    && d.note is string && d.note.size()<=2000 && d.history is list && d.history.size()>0 && d.history.size()<=100
    && d.revision is int && d.revision>0 && d.updatedAt is string;
  }
  function historyValid(old,next) {
   let h=next.history[next.history.size()-1];
   let previous=old.history.size()==100?old.history.removeAll([old.history[0]]):old.history;
   return h.keys().hasOnly(['id','action','by','to','at','note']) && h.by==request.auth.uid && h.to is list && h.to.hasOnly(next.visibleTo)
    && h.note is string && h.note.size()<=2000 && h.at==next.updatedAt
    && next.history==previous.concat([h]);
  }
  match /tasks/{id} {
   allow read: if active() && (admin() || request.auth.uid in resource.data.visibleTo);
   allow create: if taskShape(request.resource.data)
    && permission(request.resource.data.kind=='plan'?'createPlan':'createJob')
    && request.resource.data.createdBy==request.auth.uid && request.resource.data.status=='working' && request.resource.data.progress==0
    && request.resource.data.visibleTo is list && request.resource.data.visibleTo.hasAll([request.auth.uid,request.resource.data.ownerId,request.resource.data.reviewerId,request.resource.data.approverId].removeAll(['']))
    && request.resource.data.visibleTo.hasOnly([request.auth.uid,request.resource.data.ownerId,request.resource.data.reviewerId,request.resource.data.approverId])
    && memberRole(request.resource.data.ownerId,'staff') && (request.resource.data.reviewerId=='' || memberRole(request.resource.data.reviewerId,'reviewer')) && (request.resource.data.approverId=='' || memberRole(request.resource.data.approverId,'approver'))
    && request.resource.data.ownerId!=request.resource.data.reviewerId && request.resource.data.ownerId!=request.resource.data.approverId && (request.resource.data.reviewerId=='' || request.resource.data.reviewerId!=request.resource.data.approverId)
    && exists(/databases/$(database)/documents/teams/$(request.resource.data.teamId))
    && request.resource.data.history.size()==1 && request.resource.data.history[0].by==request.auth.uid;
   function editable() { return role('staff') && resource.data.ownerId==request.auth.uid && resource.data.status in ['working','blocked','revision']; }
   function reviewer() { return role('reviewer') && resource.data.reviewerId==request.auth.uid && resource.data.ownerId!=request.auth.uid && resource.data.status=='review'; }
   function approver() { return role('approver') && resource.data.approverId==request.auth.uid && resource.data.ownerId!=request.auth.uid && resource.data.reviewerId!=request.auth.uid && resource.data.status=='approval'; }
   function fields(names) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(names); }
   function action(name,to) { let h=request.resource.data.history[request.resource.data.history.size()-1]; return h.action==name && h.to==to; }
   allow update: if active() && taskShape(request.resource.data) && historyValid(resource.data,request.resource.data) && (
    ((admin() || (resource.data.createdBy==request.auth.uid && permission(resource.data.kind=='plan'?'createPlan':'createJob'))) && resource.data.status in ['working','blocked','revision']
     && action('เปลี่ยนผู้รับผิดชอบ',[request.resource.data.ownerId])
     && fields(['ownerId','reviewerId','approverId','visibleTo','updatedAt','history'])
     && request.resource.data.visibleTo.hasAll([resource.data.createdBy,request.resource.data.ownerId,request.resource.data.reviewerId,request.resource.data.approverId].removeAll(['']))
     && request.resource.data.visibleTo.hasOnly([resource.data.createdBy,request.resource.data.ownerId,request.resource.data.reviewerId,request.resource.data.approverId])
     && memberRole(request.resource.data.ownerId,'staff') && (request.resource.data.reviewerId=='' || memberRole(request.resource.data.reviewerId,'reviewer')) && (request.resource.data.approverId=='' || memberRole(request.resource.data.approverId,'approver'))
     && request.resource.data.ownerId!=request.resource.data.reviewerId && request.resource.data.ownerId!=request.resource.data.approverId && (request.resource.data.reviewerId=='' || request.resource.data.reviewerId!=request.resource.data.approverId))
    ||
    (editable() && request.resource.data.status in ['working','blocked']
     && action('อัปเดตความก้าวหน้า',[])
     && fields(['progress','reason','drawing','boq','checks','status','revision','updatedAt','history'])
     && request.resource.data.revision==(resource.data.status=='revision'?resource.data.revision+1:resource.data.revision))
    || (editable() && request.resource.data.status=='review' && fields(['status','updatedAt','history'])
     && action('ส่งตรวจ',[resource.data.reviewerId])
     && resource.data.reviewerId!='' && resource.data.approverId!=''
     && resource.data.checks==[true,true,true]
     && (!(resource.data.stage in ['ออกแบบ','ประมาณราคา']) || resource.data.drawing!='')
     && (resource.data.stage!='ประมาณราคา' || resource.data.boq!=''))
    || (reviewer() && request.resource.data.status in ['revision','approval'] && fields(['status','note','updatedAt','history']) && (request.resource.data.status!='revision' || request.resource.data.note.size()>0)
     && (request.resource.data.status=='revision'?action('ส่งกลับแก้ไข',[resource.data.ownerId]):action('ผ่านตรวจ รออนุมัติ',[resource.data.approverId])))
    || (approver() && request.resource.data.status=='done' && request.resource.data.progress==100 && fields(['status','progress','updatedAt','history']) && action('อนุมัติแล้ว',[resource.data.ownerId,resource.data.reviewerId]))
   );
  }
  match /events/{id} {
   allow read: if active() && (admin() || request.auth.uid in resource.data.visibleTo);
   allow create,update: if permission('manageSchedule') && request.resource.data.keys().hasOnly(['title','date','time','priority','kind','note','before','visibleTo','createdBy','updatedAt'])
    && request.resource.data.title is string && request.resource.data.title.size()>0 && request.resource.data.title.size()<=300
    && request.resource.data.visibleTo is list && request.auth.uid in request.resource.data.visibleTo
    && request.resource.data.priority in ['normal','important','urgent'] && request.resource.data.before is number && request.resource.data.before>=0 && request.resource.data.before<=10080;
  }
  match /vehicles/{id} {
   allow read: if active();
   allow create,update: if admin();
   allow update: if role('fleet') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bookings']);
  }
  match /trips/{id} {
   allow read: if active() && (admin() || role('fleet') || role('payroll') || request.auth.uid in resource.data.visibleTo);
   allow create: if (admin() || role('staff') || role('lead'))
    && request.resource.data.keys().hasOnly(['vehicleId','taskId','destination','driver','people','start','end','out','back','status','ownerId','visibleTo','allowanceApproved','createdAt'])
    && request.resource.data.ownerId==request.auth.uid && request.resource.data.visibleTo==[request.auth.uid]
    && request.resource.data.status=='pending' && request.resource.data.allowanceApproved==false
    && request.resource.data.out is number && request.resource.data.out>=0 && request.resource.data.back==null
    && request.resource.data.start is string && request.resource.data.end>request.resource.data.start
    && request.resource.data.people is list && request.resource.data.people.size()>0
    && exists(/databases/$(database)/documents/vehicles/$(request.resource.data.vehicleId))
    && (admin() || request.auth.uid in get(/databases/$(database)/documents/tasks/$(request.resource.data.taskId)).data.visibleTo);
   allow update: if active() && (
    ((admin() || role('fleet')) && resource.data.status=='pending' && request.resource.data.status=='approved' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
    || ((admin() || role('fleet') || request.auth.uid==resource.data.ownerId) && resource.data.status=='approved' && request.resource.data.status=='done' && request.resource.data.back is number && request.resource.data.back>=resource.data.out && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','back']))
    || ((admin() || role('payroll')) && resource.data.status=='done' && request.resource.data.allowanceApproved==true && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['allowanceApproved']))
   );
  }
  match /{document=**} { allow read,write: if false; }
 }
}
